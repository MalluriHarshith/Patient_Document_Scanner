# MongoDB Atlas Connection Details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/healthcare_db?appName=HealthcareCluster
DATABASE_NAME=healthcare_db

# Google Gemini API Key for OCR Document Parsing and RAG Chat (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads
